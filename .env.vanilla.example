# Required Minecraft settings
MINECRAFT_VERSION_NAME=26.3
MINECRAFT_PROTOCOL_VERSION=777
PLAYER_PROVIDER=management

# Required Server Management Protocol settings
MANAGEMENT_HOST=minecraft.example.internal
MANAGEMENT_PORT=25585
MANAGEMENT_SECRET=replace-me
# Optional: management TCP connection timeout; default 2000 ms
# MANAGEMENT_CONNECT_TIMEOUT_MS=2000
# Optional: management request timeout; default 3000 ms
# MANAGEMENT_REQUEST_TIMEOUT_MS=3000

# Optional proxy bind address and port; defaults 0.0.0.0 and 25565
PROXY_HOST=0.0.0.0
PROXY_PORT=25565

# Required Minecraft backend address; no default
BACKEND_HOST=minecraft.example.internal
# Optional Minecraft backend port; default 25566
BACKEND_PORT=25566
# Optional TCP connection establishment timeout; default 3000 ms
BACKEND_CONNECT_TIMEOUT_MS=3000
# Optional complete Minecraft status query timeout after connect; default 5000 ms
BACKEND_STATUS_TIMEOUT_MS=5000
# Optional maximum time for Minecraft readiness after a Pelican start; default 300000 ms
BACKEND_START_TIMEOUT_MS=300000
# Optional maximum time to confirm a Pelican stop; default 120000 ms
# BACKEND_STOP_TIMEOUT_MS=120000
# Optional consecutive readiness failures before backend is unavailable; default 3
# BACKEND_READINESS_FAILURE_THRESHOLD=3

# Required Pelican API settings
PELICAN_BASE_URL=https://pelican.example.com
PELICAN_API_KEY=replace-me
PELICAN_SERVER_ID=replace-me
# Optional Pelican API request timeout; default 5000 ms
# PELICAN_REQUEST_TIMEOUT_MS=5000

# Optional idle shutdown settings; defaults 3600000 ms and 60000 ms
IDLE_TIMEOUT_MS=3600000
IDLE_CHECK_INTERVAL_MS=60000

# Alternative RCON settings, used only when PLAYER_PROVIDER=rcon
# RCON_HOST=minecraft.example.internal
# RCON_PORT=25575
# RCON_PASSWORD=replace-me
# RCON_CONNECT_TIMEOUT_MS=2000
# RCON_REQUEST_TIMEOUT_MS=3000
