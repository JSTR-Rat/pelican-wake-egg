# Shared Minecraft status response and backend readiness probe
MINECRAFT_VERSION_NAME=26.3
MINECRAFT_PROTOCOL_VERSION=777

# Vanilla 26.3 using the Server Management Protocol
PLAYER_PROVIDER=management
MANAGEMENT_HOST=192.168.1.100
MANAGEMENT_PORT=25585
MANAGEMENT_SECRET=...

# For a modded 1.20.1 server, use this setup instead:
# MINECRAFT_VERSION_NAME=1.20.1
# MINECRAFT_PROTOCOL_VERSION=763
# PLAYER_PROVIDER=rcon
# RCON_HOST=192.168.1.100
# RCON_PORT=25575
# RCON_PASSWORD=...

# The RCON port should only be reachable by the proxy/server infrastructure.
# Do not intentionally expose it publicly.

# This URL must be reachable from inside the Pelican container. Do not use
# localhost unless the Pelican panel runs in the same container.
# PELICAN_BASE_URL=https://pelican.example.com
# PELICAN_API_KEY=...
# PELICAN_SERVER_ID=...

# On the 1.20.1 server, server.properties must also contain:
# enable-rcon=true
# rcon.port=25575
# rcon.password=<secret>
